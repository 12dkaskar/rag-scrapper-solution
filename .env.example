NODE_ENV=development
PORT=3001
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CHUNKS_INDEX=rag_chunks
ELASTICSEARCH_DOCUMENTS_INDEX=rag_documents

# One-time migration from MongoDB Atlas → Elasticsearch (not used by the running API)
MIGRATION_MONGODB_URI=
# Optional overrides (defaults match former MongoDB app settings):
# MIGRATION_MONGODB_DATABASE=rag_app
# MIGRATION_MONGODB_DOCUMENTS_COLLECTION=rag_documents
# MIGRATION_MONGODB_CHUNKS_COLLECTION=rag_chunks
# Legacy fallbacks if you still have MONGODB_URI / MONGODB_DATABASE in .env:
# MONGODB_URI=
# MIGRATION_BATCH_SIZE=500

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBED_CONCURRENCY=2
EMBED_MIN_INTERVAL_MS=650
OPENAI_API_KEY=
GEMINI_API_KEY=

GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-3.5-flash-lite
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
RAG_TOP_K=5
MAX_CONTEXT_CHARS=18000
MAX_PDF_SIZE_MB=12
MAX_FETCH_BYTES=5242880
REQUEST_TIMEOUT_MS=15000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
